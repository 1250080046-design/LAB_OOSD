  <diagram name="Trang-5" id="dhq4IQvF1HdGCT-NTAbV">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n\n@startuml\nleft to right direction\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\n\nskinparam class {\n    BackgroundColor #EAF2F8\n    BorderColor #2874A6\n    ArrowColor #2874A6\n}\n\ntitle CLASS DIAGRAM - HỆ THỐNG QUẢN LÝ BỆNH VIỆN\n\nclass BenhNhan {\n    - maBenhNhan: String &lt;&lt;PK&gt;&gt;\n    - hoTen: String\n    - diaChi: String\n    - ngaySinh: Date\n    - soDienThoai: String\n    - anh3x4: String\n}\n\nclass HoSoBenhAn {\n    - maHoSo: String &lt;&lt;PK&gt;&gt;\n    - ngayLap: Date\n    - ngayHetHanPhi: Date\n    - trangThai: String\n}\n\nclass DangKyKham {\n    - maDangKy: String &lt;&lt;PK&gt;&gt;\n    - ngayDangKy: DateTime\n    - lyDoKham: String\n    - trangThai: String\n}\n\nclass PhieuKham {\n    - maPhieuKham: String &lt;&lt;PK&gt;&gt;\n    - ngayGioKham: DateTime\n    - trieuChung: String\n    - nhietDo: Float\n    - huyetAp: String\n    - ketLuan: String\n}\n\nclass BacSi {\n    - maBacSi: String &lt;&lt;PK&gt;&gt;\n    - hoTen: String\n    - soDienThoai: String\n}\n\nclass Khoa {\n    - maKhoa: String &lt;&lt;PK&gt;&gt;\n    - tenKhoa: String\n}\n\nclass YeuCauXetNghiem {\n    - maYeuCau: String &lt;&lt;PK&gt;&gt;\n    - loaiXetNghiem: String\n    - ngayChiDinh: DateTime\n    - trangThai: String\n}\n\nclass KetQuaXetNghiem {\n    - maKetQua: String &lt;&lt;PK&gt;&gt;\n    - ngayThucHien: DateTime\n    - ketQua: String\n    - ghiChu: String\n}\n\nclass ToaThuoc {\n    - maToaThuoc: String &lt;&lt;PK&gt;&gt;\n    - ngayKeToa: DateTime\n    - loiDan: String\n}\n\nclass ChiTietToaThuoc {\n    - maChiTiet: String &lt;&lt;PK&gt;&gt;\n    - lieuLuong: String\n    - cachDung: String\n    - soLuong: Int\n    - soNgayDung: Int\n}\n\nclass Thuoc {\n    - maThuoc: String &lt;&lt;PK&gt;&gt;\n    - tenThuoc: String\n    - donViTinh: String\n    - moTa: String\n}\n\nclass ThanhToan {\n    - maThanhToan: String &lt;&lt;PK&gt;&gt;\n    - ngayThanhToan: DateTime\n    - soTien: Decimal\n    - loaiThanhToan: String\n    - trangThai: String\n}\n\nBenhNhan \&quot;1\&quot; -- \&quot;1\&quot; HoSoBenhAn : sở hữu\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyKham : đăng ký\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : lưu lịch sử\nDangKyKham \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuKham : tạo khi tiếp nhận\n\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : thực hiện\nKhoa \&quot;1\&quot; -- \&quot;0..*\&quot; BacSi : phân công\nKhoa \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : tiếp nhận khám\n\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauXetNghiem : chỉ định\nYeuCauXetNghiem \&quot;1\&quot; -- \&quot;0..1\&quot; KetQuaXetNghiem : có kết quả\n\nPhieuKham \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc : kê toa\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc : gồm\nThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietToaThuoc : được kê\n\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : thanh toán phí hồ sơ\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : thanh toán viện phí\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_rN3iGWEF3R98uI0sVaX-1">
