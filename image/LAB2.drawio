        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Class_Diagram_HeThongThuVien\n\nleft to right direction\n\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\nskinparam classAttributeIconSize 0\nskinparam ClassBackgroundColor White\nskinparam ClassBorderColor #C34B68\nskinparam ClassFontColor #202020\nskinparam ArrowColor #B94B65\n\nskinparam nodesep 45\nskinparam ranksep 60\n\nhide circle\nhide empty members\n\n&#39; ========================================\n&#39; CAC LOP CHINH\n&#39; ========================================\n\nclass DocGia {\n  maDocGia: String\n  hoTen: String\n  ngaySinh: Date\n  diaChi: String\n  soDienThoai: String\n  email: String\n  trangThai: String\n  --\n  dangKy()\n  dangNhap()\n  timKiemTaiLieu()\n  dangKyMuon()\n  dangKyMua()\n  docTrucTuyen()\n  taiTaiLieu()\n}\n\nclass ThuThu {\n  maThuThu: String\n  hoTen: String\n  soDienThoai: String\n  email: String\n  --\n  quanLyMuonTra()\n  xemTinhTrang()\n  capNhatDanhMuc()\n  chapNhanMuaSach()\n  tuChoiMuaSach()\n}\n\nclass TaiKhoan {\n  tenDangNhap: String\n  matKhau: String\n  vaiTro: String\n  trangThai: String\n  --\n  kiemTraDangNhap()\n  doiMatKhau()\n}\n\nclass TheThuVien {\n  maThe: String\n  ngayCap: Date\n  ngayHetHan: Date\n  trangThai: String\n  --\n  nhapMaThe()\n  kiemTraHieuLuc()\n}\n\nclass DanhMuc {\n  maDanhMuc: String\n  tenDanhMuc: String\n  moTa: String\n  --\n  themDanhMuc()\n  capNhatDanhMuc()\n  xoaDanhMuc()\n}\n\nclass TaiLieu {\n  maTaiLieu: String\n  tenTaiLieu: String\n  tacGia: String\n  nhaXuatBan: String\n  namXuatBan: int\n  loaiTaiLieu: String\n  soLuong: int\n  tinhTrang: String\n  duongDanFile: String\n  --\n  capNhatTinhTrang()\n  kiemTraKhaDung()\n}\n\nclass PhieuMuon {\n  maPhieuMuon: String\n  ngayMuon: Date\n  hanTra: Date\n  ngayTra: Date\n  trangThai: String\n  --\n  lapPhieuMuon()\n  capNhatTraSach()\n  kiemTraQuaHan()\n}\n\nclass ChiTietMuon {\n  maChiTietMuon: String\n  soLuong: int\n  ghiChu: String\n}\n\nclass DangKyMua {\n  maDangKyMua: String\n  ngayDangKy: Date\n  tenSachDeNghi: String\n  tacGia: String\n  nhaXuatBan: String\n  lyDoDeNghi: String\n  trangThai: String\n  --\n  guiDeNghi()\n  chapNhan()\n  tuChoi()\n}\n\nclass LuotDocTrucTuyen {\n  maLuotDoc: String\n  thoiGianDoc: DateTime\n  thoiLuong: int\n  --\n  ghiNhanLuotDoc()\n}\n\nclass ThongBaoEmail {\n  maThongBao: String\n  tieuDe: String\n  noiDung: String\n  ngayGui: DateTime\n  loaiThongBao: String\n  trangThai: String\n  --\n  guiEmailNhacQuaHan()\n}\n\n&#39; ========================================\n&#39; BO CUC\n&#39; ========================================\n\nDocGia -[hidden]down- TaiKhoan\nTaiKhoan -[hidden]right- ThuThu\n\nDocGia -[hidden]right- TheThuVien\nTheThuVien -[hidden]down- PhieuMuon\nPhieuMuon -[hidden]down- ChiTietMuon\n\nDanhMuc -[hidden]down- TaiLieu\nTaiLieu -[hidden]right- LuotDocTrucTuyen\n\nDangKyMua -[hidden]down- ThongBaoEmail\n\n&#39; ========================================\n&#39; QUAN HE\n&#39; ========================================\n\nDocGia \&quot;1\&quot; -- \&quot;1\&quot; TaiKhoan : sở hữu\nThuThu \&quot;1\&quot; -- \&quot;1\&quot; TaiKhoan : sử dụng\n\nDocGia \&quot;1\&quot; -- \&quot;1\&quot; TheThuVien : được cấp\n\nDanhMuc \&quot;1\&quot; -- \&quot;0..*\&quot; TaiLieu : phân loại\n\nDocGia \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon : đăng ký mượn\nThuThu \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon : quản lý\nTheThuVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon : xác thực\n\nPhieuMuon \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietMuon : gồm\nTaiLieu \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietMuon : được mượn\n\nDocGia \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyMua : gửi\nThuThu \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyMua : duyệt\n\nDocGia \&quot;1\&quot; -- \&quot;0..*\&quot; LuotDocTrucTuyen : thực hiện\nTaiLieu \&quot;1\&quot; -- \&quot;0..*\&quot; LuotDocTrucTuyen : được đọc\n\nDocGia \&quot;1\&quot; -- \&quot;0..*\&quot; ThongBaoEmail : nhận\nPhieuMuon \&quot;1\&quot; -- \&quot;0..*\&quot; ThongBaoEmail : phát sinh nhắc quá hạn\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ihq6OsDVvZwRiOg5FaAr-1">
