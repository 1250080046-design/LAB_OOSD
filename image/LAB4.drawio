        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml Class_Diagram_QuanLyDonHang\n\nleft to right direction\n\n&#39; ========================================\n&#39; CAU HINH GIAO DIEN\n&#39; ========================================\n\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\nskinparam classAttributeIconSize 0\nskinparam ClassBackgroundColor #FFFDDC\nskinparam ClassBorderColor #C34B68\nskinparam ClassFontColor #202020\nskinparam ArrowColor #B94B65\n\nskinparam nodesep 45\nskinparam ranksep 65\n\nhide circle\nhide empty members\n\n&#39; ========================================\n&#39; CAC LOP DOI TUONG\n&#39; ========================================\n\nclass KhachHang {\n  MaKH: INT\n  HoTen: NVARCHAR\n  NgaySinh: DATE\n  SoGiayTo: VARCHAR\n  LoaiGiayTo: VARCHAR\n  DiaChi: NVARCHAR\n  DienThoai: VARCHAR\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass TaiKhoan {\n  MaTaiKhoan: INT\n  MaKH: INT\n  TenDangNhap: VARCHAR\n  MatKhau: NVARCHAR\n  TrangThai: BIT\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass LoaiPhieuDatHang {\n  MaLoaiPhieu: INT\n  TenLoaiPhieu: NVARCHAR\n  ThoiGianXuLyGio: INT\n  MienPhiTu: DECIMAL\n  MoTa: NVARCHAR\n  TrangThai: BIT\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass KhuVucGiaoHang {\n  MaKhuVuc: INT\n  TenKhuVuc: NVARCHAR\n  MoTa: NVARCHAR\n  TrangThai: BIT\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass BangPhiGiaoHang {\n  MaKhuVuc: INT\n  MaLoaiPhieu: INT\n  PhiGiaoHang: DECIMAL\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass DonHang {\n  MaDonHang: BIGINT\n  SoDonHang: VARCHAR\n  MaKH: INT\n  MaLoaiPhieu: INT\n  MaKhuVuc: INT\n  HoTenNguoiNhan: NVARCHAR\n  DiaChiNguoiNhan: NVARCHAR\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass ChiTietDonHang {\n  MaChiTiet: BIGINT\n  MaDonHang: BIGINT\n  MaSP: VARCHAR\n  TenSPTaiThoiDiemDat: NVARCHAR\n  SoLuong: INT\n  DonGia: DECIMAL\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass GiaoDichThanhToan {\n  MaGiaoDich: BIGINT\n  MaDonHang: BIGINT\n  LoaiThe: VARCHAR\n  SoTheDaChe: VARCHAR\n  NgayHetHan: DATE\n  TenChuThe: NVARCHAR\n  SoTienThanhToan: DECIMAL\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\n&#39; ========================================\n&#39; SAP XEP BO CUC\n&#39; ========================================\n\nKhachHang -[hidden]down- TaiKhoan\n\nKhachHang -[hidden]right- DonHang\n\nLoaiPhieuDatHang -[hidden]down- BangPhiGiaoHang\n\nKhuVucGiaoHang -[hidden]down- LoaiPhieuDatHang\n\nDonHang -[hidden]down- ChiTietDonHang\n\nChiTietDonHang -[hidden]down- GiaoDichThanhToan\n\n&#39; ========================================\n&#39; QUAN HE GIUA CAC LOP\n&#39; ========================================\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; TaiKhoan\n\nKhuVucGiaoHang \&quot;1\&quot; -- \&quot;0..*\&quot; BangPhiGiaoHang\n\nLoaiPhieuDatHang \&quot;1\&quot; -- \&quot;0..*\&quot; BangPhiGiaoHang\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang\n\nLoaiPhieuDatHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang\n\nKhuVucGiaoHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang\n\nDonHang \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDonHang\n\nDonHang \&quot;1\&quot; -- \&quot;0..*\&quot; GiaoDichThanhToan\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="X75TJao49saFfsmtRxli-1">
