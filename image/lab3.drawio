      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml Hinh_2_2_UseCase_DatNhan\nleft to right direction\nskinparam shadowing false\nskinparam actorStyle awesome\nskinparam packageStyle rectangle\nskinparam defaultFontName Arial\n\nactor \&quot;Lễ tân\&quot; as LT\n\nrectangle \&quot;QUY TRÌNH ĐẶT VÀ NHẬN PHÒNG\&quot; {\n  usecase \&quot;UC04\\nĐăng ký khách hàng\&quot; as UC04\n  usecase \&quot;UC05\\nĐặt phòng\&quot; as UC05\n  usecase \&quot;UC06\\nNhận phòng\&quot; as UC06\n  usecase \&quot;UC07\\nXử lý no-show\&quot; as UC07\n\n  usecase \&quot;Kiểm tra\\nthông tin khách\&quot; as KTKhach\n  usecase \&quot;Chọn phòng và\\nsố người\&quot; as ChonPhong\n  usecase \&quot;Kiểm tra\\nsức chứa\&quot; as SucChua\n  usecase \&quot;Kiểm tra\\ntrùng lịch thuê\&quot; as TrungLich\n  usecase \&quot;Lưu phiếu đặt\\nvà chi tiết phòng\&quot; as LuuPhieu\n  usecase \&quot;Xác nhận ngày\\nnhận thực tế\&quot; as XacNhan\n  usecase \&quot;Ghi nhận\\nngười lưu trú\&quot; as NguoiLT\n  usecase \&quot;Cập nhật\\ntrạng thái Đang ở\&quot; as DangO\n  usecase \&quot;Giải phóng phòng\\nkhi no-show\&quot; as GiaiPhong\n}\n\nLT --&gt; UC04\nLT --&gt; UC05\nLT --&gt; UC06\nLT --&gt; UC07\n\nUC05 ..&gt; KTKhach : &lt;&lt;include&gt;&gt;\nUC05 ..&gt; ChonPhong : &lt;&lt;include&gt;&gt;\nUC05 ..&gt; SucChua : &lt;&lt;include&gt;&gt;\nUC05 ..&gt; TrungLich : &lt;&lt;include&gt;&gt;\nUC05 ..&gt; LuuPhieu : &lt;&lt;include&gt;&gt;\n\nUC04 ..&gt; UC05 : &lt;&lt;extend&gt;&gt;\\n[Khách chưa có hồ sơ]\n\nUC06 ..&gt; XacNhan : &lt;&lt;include&gt;&gt;\nUC06 ..&gt; NguoiLT : &lt;&lt;include&gt;&gt;\nUC06 ..&gt; DangO : &lt;&lt;include&gt;&gt;\n\nUC07 ..&gt; GiaiPhong : &lt;&lt;include&gt;&gt;\n\nnote bottom of UC05\n  Nếu vượt sức chứa hoặc trùng lịch:\n  từ chối lưu toàn bộ phiếu.\nend note\n\nnote bottom of UC06\n  Chỉ nhận phiếu ở trạng thái Đã đặt.\n  Số người lưu trú không vượt số đã đặt.\nend note\n\nnote bottom of UC07\n  No-show chỉ áp dụng khi chưa nhận phòng.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dFjWKC3NhAGbxQ881-Z2-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
