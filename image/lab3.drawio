  <diagram id="dC4-szAZcgu9t_A_BEQS" name="Page-5">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml Hinh_3_1_Class_Analysis\n\nleft to right direction\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\nskinparam ClassBackgroundColor White\nskinparam ClassBorderColor Black\nskinparam ArrowColor Black\nskinparam nodesep 35\nskinparam ranksep 40\n\nhide circle\nhide empty members\n\n&#39; ===================================\n&#39; DANH SACH CAC LOP\n&#39; ===================================\n\nclass NhanVien {\n  MaNV\n  HoTen\n  VaiTro\n  SoDienThoai\n}\n\nclass HoaDon {\n  SoHoaDon\n  NgayLap\n  SoNgayTinhTien\n  TienPhong\n  TienDichVu\n  TongTien\n  TrangThai\n  --\n  lapHoaDon()\n  tinhDuNo()\n}\n\nclass ThanhToan {\n  MaThanhToan\n  NgayThanhToan\n  HinhThuc\n  SoTien\n  --\n  ghiNhanThanhToan()\n}\n\nclass KhachHang {\n  MaKhach\n  HoTen\n  SoCMND\n  QuocTich\n  SoDienThoai\n  --\n  dangKy()\n}\n\nclass PhieuDatPhong {\n  SoPhieuDat\n  NgayLap\n  NgayNhan\n  NgayTraDuKien\n  TienCoc\n  KenhDat\n  TrangThai\n  --\n  datPhong()\n  nhanPhong()\n  noShow()\n  traPhong()\n}\n\nclass PhieuLapDat {\n  SoPhieuLapDat\n  NgayLap\n  TinhTrang\n  GhiChu\n  --\n  kiemTraTrungNgay()\n}\n\nclass Phong {\n  SoPhong\n  SoNguoiToiDa\n  DonGiaNgay\n  TrangThai\n  --\n  kiemTraSucChua()\n  kiemTraLichTrong()\n}\n\nclass KhuVuc {\n  MaKhuVuc\n  TenKhuVuc\n  --\n  taoKhuVuc()\n  capNhatTen()\n}\n\nclass PhieuSuDungDV {\n  SoPhieuSDDV\n  NgaySuDung\n  --\n  lapPhieuDichVu()\n}\n\nclass ChiTietDatPhong {\n  SoPhieuDat\n  SoPhong\n  SoNguoi\n  --\n  kiemTraSucChua()\n}\n\nclass ChiTietPhieuSuDungDV {\n  SoLuong\n  DonGia\n  ThanhTien\n  --\n  congDon()\n  tinhThanhTien()\n}\n\nclass NguoiLuuTru {\n  MaNguoiLT\n  HoTen\n  SoCMND\n  QuocTich\n}\n\nclass PhieuDenBu {\n  SoPhieuDenBu\n  NgayLap\n  TongTien\n  --\n  lapDenBu()\n}\n\nclass ChiTietPhieuDenBu {\n  MaTienNghi\n  MucDoThietHai\n  SoTien\n  --\n  tinhDenBu()\n}\n\nclass TienNghi {\n  MaTienNghi\n  SoThuTu\n  TinhTrangHienTai\n  --\n  luanChuyen()\n}\n\nclass DichVu {\n  MaDV\n  TenDV\n  DonViTinh\n  DonGia\n}\n\nclass QuyDinhDenBu {\n  MaQuyDinh\n  MucDoThietHai\n  MucDenBu\n}\n\nclass LoaiTienNghi {\n  MaLoaiTN\n  TenLoaiTN\n}\n\n&#39; ===================================\n&#39; SAP XEP BO CUC GAN GIONG SQL SERVER\n&#39; ===================================\n\nNhanVien -[hidden]down- HoaDon\nHoaDon -[hidden]right- PhieuDatPhong\nPhieuDatPhong -[hidden]right- KhachHang\n\nThanhToan -[hidden]right- HoaDon\n\nPhieuLapDat -[hidden]right- Phong\nPhong -[hidden]down- KhuVuc\n\nPhieuDatPhong -[hidden]down- PhieuSuDungDV\nPhieuSuDungDV -[hidden]down- ChiTietPhieuSuDungDV\nChiTietPhieuSuDungDV -[hidden]down- DichVu\n\nPhieuDatPhong -[hidden]down- ChiTietDatPhong\nChiTietDatPhong -[hidden]down- NguoiLuuTru\n\nPhong -[hidden]down- PhieuDenBu\nPhieuDenBu -[hidden]down- ChiTietPhieuDenBu\n\nPhieuLapDat -[hidden]down- TienNghi\nTienNghi -[hidden]down- LoaiTienNghi\nLoaiTienNghi -[hidden]left- QuyDinhDenBu\n\n&#39; ===================================\n&#39; QUAN HE GIUA CAC LOP\n&#39; ===================================\n\nKhuVuc \&quot;1\&quot; -- \&quot;0..*\&quot; Phong\n\nLoaiTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; TienNghi\nLoaiTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; QuyDinhDenBu\n\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuLapDat\nTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuLapDat\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuLapDat\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDatPhong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDatPhong\n\nPhieuDatPhong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDatPhong\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDatPhong\n\nChiTietDatPhong \&quot;1\&quot; *-- \&quot;0..*\&quot; NguoiLuuTru\n\nChiTietDatPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuSuDungDV\n\nPhieuSuDungDV \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuSuDungDV\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuSuDungDV\n\nChiTietDatPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDenBu\n\nPhieuDenBu \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuDenBu\nTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuDenBu\n\nPhieuDatPhong \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDon\nHoaDon \&quot;1\&quot; *-- \&quot;0..*\&quot; ThanhToan\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cPHvLR2oGOAWJ7DysdVa-75">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
