  <diagram id="iOxr7yU3E2gxiuzxY5N7" name="Page-6">
    <mxGraphModel dx="1460" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml Class_Diagram_QuanLyTour\n\nleft to right direction\n\n&#39; ========================================\n&#39; CAU HINH GIAO DIEN\n&#39; ========================================\n\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\nskinparam classAttributeIconSize 0\nskinparam ClassBackgroundColor White\nskinparam ClassBorderColor #C34B68\nskinparam ClassFontColor #202020\nskinparam ArrowColor #B94B65\n\nskinparam nodesep 45\nskinparam ranksep 60\n\nhide circle\nhide empty members\n\n&#39; ========================================\n&#39; 1. CAC LOP DOI TUONG\n&#39; ========================================\n\nclass Tour {\n  MaTour: varchar\n  TenTour: nvarchar\n  SoNgay: int\n  SoDem: int\n  DonGiaKhach: decimal\n  MoTa: nvarchar\n  DangMoBan: bit\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass PhuongTien {\n  MaPT: varchar\n  TenPT: nvarchar\n  GhiChu: nvarchar\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass DiemThamQuan {\n  MaDiemTQ: varchar\n  TenDiemTQ: nvarchar\n  DiaDiem: nvarchar\n  NoiDung: nvarchar\n  YNghia: nvarchar\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass DiemBanVe {\n  MaDiemBan: varchar\n  TenDiemBan: nvarchar\n  DiaChi: nvarchar\n  DienThoai: varchar\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass HuongDanVien {\n  MaHDV: varchar\n  HoTen: nvarchar\n  DienThoai: varchar\n  LuongCoBan: decimal\n  DangLamViec: bit\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass TourDiemDung {\n  MaTour: varchar\n  ThuTu: int\n  TenDiemDung: nvarchar\n  DoiPhuongTien: bit\n  CoNoiAn: bit\n  CoKhachSan: bit\n  HangSaoKhachSan: int\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass TourPhuongTien {\n  MaTour: varchar\n  ThuTuChang: int\n  MaPT: varchar\n  GhiChu: nvarchar\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass TourDiemThamQuan {\n  MaTour: varchar\n  MaDiemTQ: varchar\n  ThuTu: int\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass ChuyenLe {\n  MaChuyen: varchar\n  MaTour: varchar\n  NgayDi: date\n  NgayVe: date\n  DiaDiemDon: nvarchar\n  TrangThai: nvarchar\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass DoanKhach {\n  MaDoan: varchar\n  TenCoQuanDaiDien: nvarchar\n  DiaChi: nvarchar\n  DienThoai: varchar\n  NguoiDaiDien: nvarchar\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass DangKyDoan {\n  SoDKDoan: varchar\n  MaDoan: varchar\n  MaTour: varchar\n  NgayDangKy: datetime2\n  NgayDi: date\n  NgayKetThucDuKien: date\n  SoNguoi: int\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass ThanhVienDoan {\n  SoDKDoan: varchar\n  STT: int\n  HoTen: nvarchar\n  NgaySinh: date\n  SoGiayTo: nvarchar\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass DangKyLe {\n  SoDKLe: varchar\n  MaChuyen: varchar\n  MaDiemBan: varchar\n  NgayDangKy: datetime2\n  TenNguoiDangKy: nvarchar\n  DienThoai: varchar\n  SoNguoi: int\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass PhanCongHDV {\n  MaPC: varchar\n  MaHDV: varchar\n  LoaiDoiTuong: varchar\n  MaChuyen: varchar\n  SoDKDoan: varchar\n  NgayBatDau: date\n  NgayKetThuc: date\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass ThanhToanDoan {\n  SoTT: varchar\n  SoDKDoan: varchar\n  NgayThanhToan: datetime2\n  SoTien: decimal\n  GhiChu: nvarchar\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\nclass KhaoSat {\n  MaKhaoSat: varchar\n  LoaiKhach: varchar\n  SoDKLe: varchar\n  SoDKDoan: varchar\n  NgayGui: date\n  NgayPhanHoi: date\n  DiemDanhGia: int\n  --\n  kiemTraDuLieu(): boolean\n  traCuu(): void\n}\n\n&#39; ========================================\n&#39; 2. SAP XEP BO CUC\n&#39; ========================================\n\nTour -[hidden]down- TourDiemDung\nTourDiemDung -[hidden]down- TourPhuongTien\nTourPhuongTien -[hidden]down- TourDiemThamQuan\n\nPhuongTien -[hidden]down- DiemThamQuan\nDiemThamQuan -[hidden]down- DiemBanVe\n\nTour -[hidden]right- ChuyenLe\nChuyenLe -[hidden]down- DangKyLe\nDangKyLe -[hidden]down- KhaoSat\n\nDoanKhach -[hidden]down- DangKyDoan\nDangKyDoan -[hidden]down- ThanhVienDoan\nThanhVienDoan -[hidden]down- ThanhToanDoan\n\nHuongDanVien -[hidden]down- PhanCongHDV\n\n&#39; ========================================\n&#39; 3. QUAN HE TOUR VA DANH MUC\n&#39; ========================================\n\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; TourDiemDung\n\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; TourPhuongTien\n\nPhuongTien \&quot;1\&quot; -- \&quot;0..*\&quot; TourPhuongTien\n\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; TourDiemThamQuan\n\nDiemThamQuan \&quot;1\&quot; -- \&quot;0..*\&quot; TourDiemThamQuan\n\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; ChuyenLe\n\n&#39; ========================================\n&#39; 4. QUAN HE DANG KY DOAN\n&#39; ========================================\n\nDoanKhach \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyDoan\n\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyDoan\n\nDangKyDoan \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhVienDoan\n\nDangKyDoan \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanDoan\n\n&#39; ========================================\n&#39; 5. QUAN HE DANG KY LE\n&#39; ========================================\n\nChuyenLe \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyLe\n\nDiemBanVe \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyLe\n\n&#39; ========================================\n&#39; 6. QUAN HE PHAN CONG HDV\n&#39; ========================================\n\nHuongDanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCongHDV\n\nChuyenLe \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCongHDV\n\nDangKyDoan \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCongHDV\n\n&#39; ========================================\n&#39; 7. QUAN HE KHAO SAT\n&#39; ========================================\n\nDangKyLe \&quot;1\&quot; -- \&quot;0..*\&quot; KhaoSat\n\nDangKyDoan \&quot;1\&quot; -- \&quot;0..*\&quot; KhaoSat\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ay3bAHylgc2MrE_InqBK-339">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
