        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam nodesep 40\nskinparam ranksep 50\nhide methods\n\nclass NhanVien {\n  + maNV: String\n  + hoTen: String\n  + ngaySinh: Date\n  + gioiTinh: String\n  + diaChi: String\n  + soDienThoai: String\n  + email: String\n}\n\nclass HoSoBaoHiem {\n  + maHoSo: int\n  + loaiBaoHiem: String\n  + ngayBatDau: Date\n  + ngayKetThuc: Date\n}\n\nclass TuyenDung {\n  + maTuyenDung: int\n  + viTri: String\n  + ngayDang: Date\n  + hanNop: Date\n  + trangThai: String\n}\n\nclass HoSoUngVien {\n  + maUngVien: int\n  + hoTen: String\n  + email: String\n  + soDienThoai: String\n  + ketQua: String\n}\n\nclass HopDongLaoDong {\n  + maHopDong: int\n  + ngayKy: Date\n  + ngayHetHan: Date\n  + loaiHopDong: String\n  + mucLuong: double\n}\n\nclass QuyetDinhLuong {\n  + maQuyetDinhLuong: int\n  + mucLuong: double\n  + ngayApDung: Date\n}\n\nclass QuyetDinhChucVu {\n  + maQuyetDinhChucVu: int\n  + chucVu: String\n  + ngayApDung: Date\n}\n\nclass KhenThuongKyLuat {\n  + maQuyetDinh: int\n  + loaiQuyetDinh: String\n  + noiDung: String\n  + ngayQuyetDinh: Date\n}\n\nclass LichLamViec {\n  + maLich: int\n  + ngayLam: Date\n  + caLam: String\n  + gioBatDau: Time\n  + gioKetThuc: Time\n}\n\nclass ChamCong {\n  + maChamCong: int\n  + ngayChamCong: Date\n  + gioVao: Time\n  + gioRa: Time\n  + trangThai: String\n}\n\nclass BangLuong {\n  + maBangLuong: int\n  + thang: int\n  + nam: int\n  + tongLuong: double\n  + ngayLap: Date\n}\n\nclass PhieuThuChi {\n  + maPhieu: int\n  + loaiPhieu: String\n  + noiDung: String\n  + soTien: double\n  + ngayLap: Date\n}\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoBaoHiem\nTuyenDung \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoUngVien\nHoSoUngVien \&quot;0..1\&quot; -- \&quot;0..1\&quot; HopDongLaoDong\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; KhenThuongKyLuat\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; LichLamViec\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChamCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangLuong\n\nLichLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChamCong\nBangLuong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuThuChi\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cRijTzJ7fl4hXW6l9QT8-1">
