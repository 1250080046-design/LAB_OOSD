    <mxGraphModel dx="1555" dy="972" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle CLASS DIAGRAM - QUAN LY CHO THUE VAN PHONG CAO OC\n\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\n\n\nclass Tang {\n    - maTang: int &lt;&lt;PK&gt;&gt;\n    - tenTang: String\n    - moTa: String\n}\n\nclass Phong {\n    - maPhong: int &lt;&lt;PK&gt;&gt;\n    - maTang: int &lt;&lt;FK&gt;&gt;\n    - maSoPhong: String\n    - huong: String\n    - dienTich: double\n    - donGiaThue: decimal\n    - tinhTrang: String\n}\n\nTang \&quot;1\&quot; -- \&quot;0..*\&quot; Phong : bao gom\n\n\n\nclass KhachHang {\n    - maKhachHang: int &lt;&lt;PK&gt;&gt;\n    - hoTen: String\n    - soDienThoai: String\n    - email: String\n    - diaChi: String\n}\n\nclass CongTyThue {\n    - maCongTy: int &lt;&lt;PK&gt;&gt;\n    - tenCongTy: String\n    - maSoThue: String\n    - diaChi: String\n    - soDienThoai: String\n    - email: String\n}\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HopDong : dai dien ky\n\n\nclass HopDong {\n    - maHopDong: int &lt;&lt;PK&gt;&gt;\n    - maKhachHang: int &lt;&lt;FK&gt;&gt;\n    - maCongTy: int &lt;&lt;FK&gt;&gt;\n    - ngayLap: Date\n    - ngayBatDau: Date\n    - ngayKetThuc: Date\n    - tongTienThue: decimal\n    - trangThai: String\n}\n\nclass ChiTietHopDong {\n    - maChiTiet: int &lt;&lt;PK&gt;&gt;\n    - maHopDong: int &lt;&lt;FK&gt;&gt;\n    - maPhong: int &lt;&lt;FK&gt;&gt;\n    - donGiaThue: decimal\n    - thoiHanThue: int\n}\n\nclass PhieuGiaHan {\n    - maPhieuGiaHan: int &lt;&lt;PK&gt;&gt;\n    - maHopDong: int &lt;&lt;FK&gt;&gt;\n    - ngayGiaHan: Date\n    - thoiGianGiaHan: int\n    - ngayKetThucMoi: Date\n}\n\nCongTyThue \&quot;1\&quot; -- \&quot;0..*\&quot; HopDong : thue\nHopDong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHopDong : co\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHopDong : duoc thue\nHopDong \&quot;1\&quot; *-- \&quot;0..*\&quot; PhieuGiaHan : co\n\n\nclass ThanhToanTienThue {\n    - maThanhToan: int &lt;&lt;PK&gt;&gt;\n    - maHopDong: int &lt;&lt;FK&gt;&gt;\n    - ngayThanhToan: Date\n    - soTien: decimal\n    - kyThanhToan: String\n    - phuongThuc: String\n    - trangThai: String\n}\n\nHopDong \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanTienThue : thanh toan\n\n\nclass LoaiDichVu {\n    - maDichVu: int &lt;&lt;PK&gt;&gt;\n    - tenDichVu: String\n    - donGia: decimal\n    - donViTinh: String\n}\n\nclass HoaDonDichVu {\n    - maHoaDon: int &lt;&lt;PK&gt;&gt;\n    - maHopDong: int &lt;&lt;FK&gt;&gt;\n    - ngayLap: Date\n    - thangThanhToan: String\n    - tongTien: decimal\n    - trangThai: String\n}\n\nclass ChiTietHoaDonDichVu {\n    - maChiTiet: int &lt;&lt;PK&gt;&gt;\n    - maHoaDon: int &lt;&lt;FK&gt;&gt;\n    - maDichVu: int &lt;&lt;FK&gt;&gt;\n    - maPhong: int &lt;&lt;FK&gt;&gt;\n    - chiSoCu: double\n    - chiSoMoi: double\n    - soLuongSuDung: double\n    - thanhTien: decimal\n}\n\nclass ThanhToanDichVu {\n    - maThanhToan: int &lt;&lt;PK&gt;&gt;\n    - maHoaDon: int &lt;&lt;FK&gt;&gt;\n    - ngayThanhToan: Date\n    - soTien: decimal\n    - phuongThuc: String\n    - trangThai: String\n}\n\nHopDong \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonDichVu : phat sinh\nHoaDonDichVu \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHoaDonDichVu : gom\nLoaiDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDonDichVu : ap dung\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDonDichVu : su dung\nHoaDonDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanDichVu : duoc thanh toan\n\n\nclass NhanVienCongTy {\n    - maNhanVien: int &lt;&lt;PK&gt;&gt;\n    - maCongTy: int &lt;&lt;FK&gt;&gt;\n    - maPhong: int &lt;&lt;FK&gt;&gt;\n    - hoTen: String\n    - hinhAnh: String\n    - chucVu: String\n    - ngayVaoLam: Date\n}\n\nCongTyThue \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienCongTy : co\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienCongTy : lam viec\n\n&#39; =========================\n&#39; 7. QUAN LY THE GIU XE\n&#39; =========================\n\nclass TheGiuXe {\n    - maThe: int &lt;&lt;PK&gt;&gt;\n    - maNhanVien: int &lt;&lt;FK&gt;&gt;\n    - maPhuongTien: int &lt;&lt;FK&gt;&gt;\n    - ngayCap: Date\n    - trangThai: String\n}\n\nclass PhuongTien {\n    - maPhuongTien: int &lt;&lt;PK&gt;&gt;\n    - bienSoXe: String\n    - loaiXe: String\n    - mauXe: String\n}\n\nNhanVienCongTy \&quot;1\&quot; -- \&quot;0..*\&quot; TheGiuXe : duoc cap\nPhuongTien \&quot;1\&quot; -- \&quot;0..*\&quot; TheGiuXe : dang ky\n\n\nclass KiemTraPhong {\n    - maKiemTra: int &lt;&lt;PK&gt;&gt;\n    - maPhong: int &lt;&lt;FK&gt;&gt;\n    - ngayKiemTra: Date\n    - noiDung: String\n    - ketQua: String\n}\n\nclass BienBanViPham {\n    - maBienBan: int &lt;&lt;PK&gt;&gt;\n    - maPhong: int &lt;&lt;FK&gt;&gt;\n    - maKiemTra: int &lt;&lt;FK&gt;&gt;\n    - ngayLap: Date\n    - noiDungViPham: String\n    - mucPhat: decimal\n    - trangThai: String\n}\n\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; KiemTraPhong : duoc kiem tra\nKiemTraPhong \&quot;1\&quot; -- \&quot;0..*\&quot; BienBanViPham : ghi nhan\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; BienBanViPham : co vi pham\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UaQRqPpfCiGKkyJl83u6-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
