 usecase "Thanh toán\nhóa đơn" as UC8
 usecase "Lập phiếu\ngia hạn" as UC9
 usecase "Quản lý nhân viên\ncủa công ty thuê" as UC10
 usecase "Cấp thẻ\ngiữ xe" as UC11
 usecase "Kiểm tra phòng\nđịnh kỳ" as UC12
 usecase "Ghi nhận vi phạm\nchỉnh sửa kết cấu" as UC13
}
KH --> UC1
KH --> UC4
KH --> UC9
QL --> UC2
QL --> UC3
QL --> UC4
QL --> UC9
QL --> UC10
KT --> UC5
